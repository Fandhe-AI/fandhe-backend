+impl GateOutcome {
+    /// 判定結果が `Allow`（許可）かどうかを返す。
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use fandhe_backend_core::extension::GateOutcome;
+    ///
+    /// assert!(GateOutcome::Allow.is_allowed());
+    /// assert!(!GateOutcome::Reject { status: 401, body: Vec::new() }.is_allowed());
+    /// ```
+    pub fn is_allowed(&self) -> bool {
+        matches!(self, GateOutcome::Allow)
+    }
+
+    /// 判定結果が `Reject`（拒否）かどうかを返す。[`GateOutcome::is_allowed`] の否定。
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use fandhe_backend_core::extension::GateOutcome;
+    ///
+    /// assert!(!GateOutcome::Allow.is_rejected());
+    /// assert!(GateOutcome::Reject { status: 401, body: Vec::new() }.is_rejected());
+    /// ```
+    pub fn is_rejected(&self) -> bool {
+        !self.is_allowed()
+    }
+}
