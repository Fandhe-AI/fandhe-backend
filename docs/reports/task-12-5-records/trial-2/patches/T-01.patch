+/// [`noop_middleware`] が返す何もしない [`Middleware`] 実装。
+///
+/// フィールドを持たないため配線コストはゼロ（pay-for-what-you-use）。
+struct NoopMiddleware;
+
+impl Middleware for NoopMiddleware {
+    fn name(&self) -> &'static str {
+        "noop-middleware"
+    }
+
+    fn on_request(&self, _head: &RequestHead) {}
+
+    fn on_response(&self, _head: &RequestHead, _elapsed: Duration) {}
+}
+
+/// 観測を行わない [`Middleware`] を生成するファクトリ。
+///
+/// `Middleware` の契約（観測専用・`head` を変更しない・同期ブロッキング I/O
+/// を行わない）を最小の形で満たす実装であり、`on_request`/`on_response` は
+/// 何も行わない。ミドルウェアチェーンの配線を検証する試験用スタブや、
+/// feature 無効時のプレースホルダとしての利用を想定する。
+///
+/// # Examples
+///
+/// ```
+/// use fandhe_backend_core::extension::{noop_middleware, Middleware};
+/// use fandhe_backend_http::request::{parse_request_head, ParseOutcome};
+/// use std::time::Duration;
+///
+/// let mw = noop_middleware();
+/// assert_eq!(mw.name(), "noop-middleware");
+///
+/// let buf = b"GET / HTTP/1.1\r\n\r\n";
+/// let head = match parse_request_head(buf).unwrap() {
+///     ParseOutcome::Complete { head, .. } => head,
+///     ParseOutcome::Incomplete => unreachable!(),
+/// };
+/// // 何もしない実装なのでパニックせず呼び出せることを確認する。
+/// mw.on_request(&head);
+/// mw.on_response(&head, Duration::from_millis(1));
+/// ```
+pub fn noop_middleware() -> impl Middleware {
+    NoopMiddleware
+}
