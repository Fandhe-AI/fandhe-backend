+
+    /// 大文字小文字を無視して `name` に一致する全ヘッダ値を出現順で取得する。
+    ///
+    /// [`RequestHead::header`] は最初の 1 件しか返さないため、同名ヘッダが
+    /// 複数存在しうる文脈（例: `Cookie` の分割送出や、大小文字違いの重複
+    /// ヘッダを取りこぼさず検査したい呼び出し元）向けに全件を返す。
+    /// 大文字小文字の比較方式は [`RequestHead::header`] と同一
+    /// （`str::eq_ignore_ascii_case`）で統一する。
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use fandhe_backend_http::request::parse_request_head;
+    ///
+    /// let buf = b"GET / HTTP/1.1\r\nX-A: 1\r\nx-a: 2\r\nX-B: 3\r\n\r\n";
+    /// let outcome = parse_request_head(buf).unwrap();
+    /// let head = match outcome {
+    ///     fandhe_backend_http::request::ParseOutcome::Complete { head, .. } => head,
+    ///     _ => unreachable!(),
+    /// };
+    /// assert_eq!(head.headers_by_name("x-a"), vec!["1", "2"]);
+    /// assert!(head.headers_by_name("missing").is_empty());
+    /// ```
+    pub fn headers_by_name(&self, name: &str) -> Vec<&str> {
+        self.headers
+            .iter()
+            .filter(|(k, _)| k.eq_ignore_ascii_case(name))
+            .map(|(_, v)| v.as_str())
+            .collect()
+    }
 }
 
