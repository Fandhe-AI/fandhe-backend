+    fn headers_by_name_collects_case_insensitive_duplicates_in_order() {
+        let buf =
+            b"GET / HTTP/1.1\r\nContent-Type: text/plain\r\ncontent-type: text/html\r\nX-Other: z\r\n\r\n";
