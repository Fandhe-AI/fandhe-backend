+impl GateOutcome {
+    /// この判定結果が許可（[`GateOutcome::Allow`]）かどうかを返す。
+    ///
+    /// コアループ（#70 実装分）やテストコードで `match` を書かずに許可/拒否を
+    /// 判定したい場合の補助メソッド。バリアント構成・シリアライズ形式には
+    /// 影響しない（`#[derive(Debug, Clone, PartialEq, Eq)]` はそのまま）。
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use fandhe_backend_core::extension::GateOutcome;
+    ///
+    /// assert!(GateOutcome::Allow.is_allowed());
+    /// assert!(!GateOutcome::Reject { status: 401, body: Vec::new() }.is_allowed());
+    /// ```
+    pub fn is_allowed(&self) -> bool {
+        matches!(self, GateOutcome::Allow)
+    }
+
+    /// この判定結果が拒否（[`GateOutcome::Reject`]）かどうかを返す。
+    /// [`GateOutcome::is_allowed`] の否定と等価。
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use fandhe_backend_core::extension::GateOutcome;
+    ///
+    /// assert!(GateOutcome::Reject { status: 403, body: Vec::new() }.is_rejected());
+    /// assert!(!GateOutcome::Allow.is_rejected());
+    /// ```
+    pub fn is_rejected(&self) -> bool {
+        !self.is_allowed()
+    }
+}
+
