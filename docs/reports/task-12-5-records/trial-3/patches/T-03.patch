+/// `names` に列挙した候補ヘッダ名を先頭から順に [`RequestHead::header`] で
+/// 検索し、最初に見つかった値を返す。
+///
+/// 同一の意味を持つヘッダに複数の名称（例: 別名・大文字小文字表記ゆれ）が
+/// あり得る場合の呼び出し元（プラグイン等）向けヘルパー。大文字小文字の
+/// 区別をしない挙動は内部で使う [`RequestHead::header`] にすべて委譲し、
+/// 本関数自身は `names` の走査順序のみを制御する。既存の
+/// [`RequestHead::header`] / [`RequestHead::headers`] の挙動・シグネチャは
+/// 変更しない。
+///
+/// # Examples
+///
+/// ```
+/// use fandhe_backend_http::request::{find_header_any, parse_request_head};
+///
+/// let buf = b"GET / HTTP/1.1\r\nHost: example.com\r\n\r\n";
+/// let outcome = parse_request_head(buf).unwrap();
+/// let head = match outcome {
+///     fandhe_backend_http::request::ParseOutcome::Complete { head, .. } => head,
+///     _ => unreachable!(),
+/// };
+/// // 候補名は大文字小文字を区別せず、出現順に評価される。
+/// assert_eq!(find_header_any(&head, &["X-Missing", "HOST"]), Some("example.com"));
+/// assert_eq!(find_header_any(&head, &["X-Missing", "X-Also-Missing"]), None);
+/// ```
+pub fn find_header_any<'a>(head: &'a RequestHead, names: &[&str]) -> Option<&'a str> {
+    names.iter().find_map(|name| head.header(name))
+}
