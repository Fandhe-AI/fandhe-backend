+    #[test]
+    fn find_header_any_matches_case_insensitively_regardless_of_candidate_order() {
+        let buf = b"GET / HTTP/1.1\r\nX-Real-Name: example.com\r\n\r\n";
+        let (head, _) = complete(buf);
+        // 候補名の大文字小文字が実ヘッダ名（X-Real-Name）と混在していても一致する。
+        assert_eq!(
+            find_header_any(&head, &["x-missing", "X-REAL-NAME"]),
+            Some("example.com")
+        );
+        assert_eq!(
+            find_header_any(&head, &["X-Real-Name", "x-missing"]),
+            Some("example.com")
+        );
+    }
+
+    #[test]
+    fn find_header_any_returns_first_matching_candidate_in_names_order() {
+        let buf = b"GET / HTTP/1.1\r\nX-A: first\r\nX-B: second\r\n\r\n";
+        let (head, _) = complete(buf);
+        // names の走査順が優先される（X-B が先に列挙されれば X-B が優先）。
+        assert_eq!(find_header_any(&head, &["x-b", "x-a"]), Some("second"));
+        assert_eq!(find_header_any(&head, &["x-a", "x-b"]), Some("first"));
+    }
+
+    #[test]
+    fn find_header_any_returns_none_when_no_candidate_matches() {
+        let buf = b"GET / HTTP/1.1\r\nHost: example.com\r\n\r\n";
+        let (head, _) = complete(buf);
+        assert_eq!(
+            find_header_any(&head, &["x-missing", "x-also-missing"]),
+            None
+        );
+        assert_eq!(find_header_any(&head, &[]), None);
+    }
