+    /// .claude/rules/feature-modification.md）。
+    #[test]
+    fn version_matches_cargo_toml_package_version() {
+        // `CARGO_PKG_VERSION` はビルド元の Cargo.toml の package.version を
+        // cargo が直接埋め込む環境変数であり、`Cargo.toml` の値そのもの。
+        assert_eq!(version(), env!("CARGO_PKG_VERSION"));
