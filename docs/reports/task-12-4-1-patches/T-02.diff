+impl GateOutcome {
+    /// このアウトカムが「許可」であるかを判定するヘルパー。
+    ///
+    /// `matches!` の呼び出し箇所を各プラグイン・コア実装に散らさず、
+    /// `GateOutcome` 側に判定ロジックを一箇所に集約する。バリアント数・
+    /// シリアライズ形式（`#[derive(Debug, Clone, PartialEq, Eq)]`）は
+    /// 変更しない。
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use backend_framework_core::extension::GateOutcome;
+    ///
+    /// assert!(GateOutcome::Allow.is_allowed());
+    ///
+    /// let rejected = GateOutcome::Reject { status: 401, body: Vec::new() };
+    /// assert!(!rejected.is_allowed());
+    /// ```
+    pub fn is_allowed(&self) -> bool {
+        matches!(self, GateOutcome::Allow)
+    }
+}
+
 /// 早期拒否可能な拡張点。認証・認可・同意ゲート等、ルーティング前に
