+
+    /// 複数のヘッダ名候補を優先順位付きで順に走査し、大文字小文字を無視して
+    /// 最初に見つかった値を返す。
+    ///
+    /// 各候補は内部で [`RequestHead::header`] に委譲するため、大文字小文字を
+    /// 無視した先頭一致という既存の挙動をそのまま踏襲する。`X-Forwarded-For`
+    /// と `Forwarded` のように別名を持つヘッダを優先順位付きで探索したい
+    /// 呼び出し元（プラグイン層等）向けのヘルパー。
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use bf_http::request::parse_request_head;
+    ///
+    /// let buf = b"GET / HTTP/1.1\r\nX-Forwarded-For: 1.2.3.4\r\n\r\n";
+    /// let outcome = parse_request_head(buf).unwrap();
+    /// let head = match outcome {
+    ///     bf_http::request::ParseOutcome::Complete { head, .. } => head,
+    ///     _ => unreachable!(),
+    /// };
+    /// assert_eq!(
+    ///     head.header_any(&["forwarded", "x-forwarded-for"]),
+    ///     Some("1.2.3.4")
+    /// );
+    /// assert_eq!(head.header_any(&["missing-a", "missing-b"]), None);
+    /// ```
+    pub fn header_any(&self, names: &[&str]) -> Option<&str> {
+        names.iter().find_map(|name| self.header(name))
+    }
 }
 
