+    #[test]
+    fn header_any_returns_first_matching_candidate_case_insensitively() {
+        let buf = b"GET / HTTP/1.1\r\nX-A: 1\r\nX-B: 2\r\n\r\n";
+        let (head, _) = complete(buf);
+        // 実ヘッダ名は大文字（"X-A"）、検索候補は小文字（"x-a"）で渡しても一致する。
+        assert_eq!(head.header_any(&["x-a", "x-b"]), Some("1"));
+        // 優先順位: 先に見つかった候補（"x-b"）の値を返す。
+        assert_eq!(head.header_any(&["x-b", "x-a"]), Some("2"));
+    }
+
+    #[test]
+    fn header_any_falls_through_to_next_candidate_when_missing() {
+        let buf = b"GET / HTTP/1.1\r\nForwarded: for=1.2.3.4\r\n\r\n";
+        let (head, _) = complete(buf);
+        // 先頭候補が存在しない場合は次の候補にフォールスルーする。
+        assert_eq!(
+            head.header_any(&["X-Forwarded-For", "forwarded"]),
+            Some("for=1.2.3.4")
+        );
+    }
+
+    #[test]
+    fn header_any_returns_none_when_no_candidate_matches() {
+        let buf = b"GET / HTTP/1.1\r\nHost: example.com\r\n\r\n";
+        let (head, _) = complete(buf);
+        assert_eq!(head.header_any(&["X-Missing-A", "x-missing-b"]), None);
+    }
+
